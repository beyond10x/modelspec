+/// PROBE: the loss sum moved after the most-FLOP later work it has no hazard with.
+fn step_order(works: &[Work]) -> Vec<usize> {
+    let mut order: Vec<usize> = (0..works.len()).collect();
+    let Some(loss) = works
+        .iter()
+        .position(|w| matches!(&w.kernels[..], [k] if k.kind == KernelKind::LossSum))
+    else {
+        return order;
+    };
+    let buffers = |views: &[BufferView]| views.iter().map(|v| v.buffer).collect::<BTreeSet<u32>>();
+    let reads = buffers(&works[loss].reads);
+    let writes = buffers(&works[loss].writes);
+    let mut best: Option<(u64, usize)> = None;
+    for (at, work) in works.iter().enumerate().skip(loss + 1) {
+        let w = buffers(&work.writes);
+        let r = buffers(&work.reads);
+        if !w.is_disjoint(&reads) || !w.is_disjoint(&writes) || !r.is_disjoint(&writes) {
+            break;
+        }
+        let flop = match &work.kernels[..] {
+            [k] if k.kind == KernelKind::MatMul => k.flop().unwrap_or(0),
+            _ => 0,
+        };
+        if flop > 0 && best.is_none_or(|(f, _)| flop > f) {
+            best = Some((flop, at));
+        }
+    }
+    if let Some((_, at)) = best {
+        let moved = order.remove(loss);
+        if std::env::var_os("MODELSPEC_PROBE_LEAD").is_some() {
+            order.insert(at - 1, moved);
+        } else {
+            order.insert(at, moved);
+        }
+    }
+    order
+}
