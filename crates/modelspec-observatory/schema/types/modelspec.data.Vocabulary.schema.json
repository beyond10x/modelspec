  "$defs": {
    "modelspec.data.Vocabulary": {
      "title": "Vocabulary",
      "description": "The tokens a tokenizer maps text to; a token's id is its position in tokens (about 30k for BERT-tiny, epic:bert-from-scratch). mask_token_id names the token 80/10/10 masking substitutes.",
      "x-ess-name": "modelspec.data.Vocabulary",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "tokens": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mask_token_id": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "tokens",
        "mask_token_id"
      ],
      "additionalProperties": false,
      "x-ess-invariants": [
        "distinct token in tokens",
        "mask_token_id >= 0",
        "mask_token_id < tokens.count"
      ]
    }
  }
