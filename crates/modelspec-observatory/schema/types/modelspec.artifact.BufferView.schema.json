  "$defs": {
    "modelspec.artifact.BufferView": {
      "title": "BufferView",
      "description": "A typed view of a plan buffer (DESIGN.md § 7.1). size_bytes equals element_count times dtype.size_bytes and offset is a multiple of alignment; ESS states neither here. Device ownership (§ 7.1) is not yet typed.",
      "x-ess-name": "modelspec.artifact.BufferView",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "buffer": {
          "description": "The plan-local number of the allocation the view lies in (DESIGN.md § 3.1 resources).",
          "type": "integer",
          "minimum": 0
        },
        "dtype": {
          "$ref": "#/$defs/modelspec.checkpoint.DType"
        },
        "element_count": {
          "description": "Logical element count (DESIGN.md § 7.1).",
          "type": "integer",
          "minimum": 1
        },
        "offset": {
          "description": "Start of the allocation range, in bytes (DESIGN.md § 7.1).",
          "type": "integer",
          "minimum": 0
        },
        "size_bytes": {
          "description": "Length of the allocation range, in bytes (DESIGN.md § 7.1).",
          "type": "integer",
          "minimum": 1
        },
        "alignment": {
          "description": "Alignment of the view, in bytes (DESIGN.md § 7.1).",
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "buffer",
        "dtype",
        "element_count",
        "offset",
        "size_bytes",
        "alignment"
      ],
      "additionalProperties": false,
      "x-ess-invariants": [
        "buffer >= 0",
        "element_count > 0",
        "offset >= 0",
        "size_bytes > 0",
        "size_bytes >= dtype.size_bytes",
        "alignment > 0"
      ]
    },
    "modelspec.checkpoint.DType": {
      "title": "DType",
      "description": "A tensor element type and its size in bytes; `f32` is the only M0/M1 dtype (DESIGN.md § 2.2).",
      "x-ess-name": "modelspec.checkpoint.DType",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "F32"
      ],
      "x-ess-attributes": [
        {
          "kind": "integer",
          "name": "size_bytes",
          "type": "Integer",
          "values": {
