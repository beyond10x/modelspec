          "type": "number"
        },
        "random_fraction": {
          "type": "number"
        },
        "keep_fraction": {
          "type": "number"
        }
      },
      "required": [
        "selection_rate",
        "mask_fraction",
        "random_fraction",
        "keep_fraction"
      ],
      "additionalProperties": false,
      "x-ess-invariants": [
        "selection_rate > 0",
        "selection_rate <= 1",
        "mask_fraction >= 0",
        "random_fraction >= 0",
