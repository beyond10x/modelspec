  "$defs": {
    "modelspec.observatory.Histogram": {
      "title": "Histogram",
      "description": "The distribution of one tensor's elements in bins; bin i counts the elements in [bin_edges[i], bin_edges[i+1]), so there is one more edge than counts, which ESS does not state here.",
      "x-ess-name": "modelspec.observatory.Histogram",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "bin_edges": {
          "description": "The bin edges in ascending order; an edge is null when it is NaN or ±inf, which Binary64 does not hold (wave observatory-1 coordinator, 2026-10-21).",
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "counts": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      },
      "required": [
        "bin_edges",
        "counts"
      ],
      "additionalProperties": false,
      "x-ess-invariants": [
        "forall count in counts: (count >= 0)"
      ]
    }
  }
}
