{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KernelModule",
  "description": "One generated SPIR-V module of a Vulkan artifact (DESIGN.md § 3, target lowering; § 7.1).",
  "x-ess-name": "modelspec.artifact.KernelModule",
  "x-ess-kind": "entity",
  "type": "object",
  "properties": {
    "kernel_module_id": {
      "$ref": "#/$defs/modelspec.artifact.KernelModuleId"
    },
    "artifact_id": {
      "$ref": "#/$defs/modelspec.artifact.ArtifactId",
      "x-ess-relation": {
        "name": "kernels",
        "kind": "owns",
        "source": "modelspec.artifact.CompiledArtifact",
        "target": "modelspec.artifact.KernelModule",
        "cardinality": "many",
        "via": "artifact_id"
      }
    },
    "entry_point": {
      "type": "string"
    },
    "spirv": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "contentEncoding": "base64"
    },
    "cache_key": {
      "$ref": "#/$defs/modelspec.artifact.KernelCacheKey",
      "description": "The configuration cache key this module was built under (DESIGN.md § 5.3)."
    },
    "state": {
      "$ref": "#/$defs/modelspec.artifact.KernelModule.State"
    }
  },
  "required": [
    "kernel_module_id",
    "artifact_id",
    "entry_point",
    "spirv",
    "cache_key",
    "state"
  ],
  "additionalProperties": false,
  "x-ess-provenance": {
    "system": "modelspec",
    "specification_version": "v1",
    "source_digest": "99c6aab814720fd964fd2d81cf10c6edea444770db2ce865ce83d33f811ec212",
    "contract_digest": "slice-sha256/2:1c26d16aff700a5c5e2eb771ae7784ed078ecbe7adace8ea732b94799fc8c748",
    "regenerate": "ess generate"
  },
  "$defs": {
    "modelspec.artifact.ArtifactId": {
      "title": "ArtifactId",
      "x-ess-name": "modelspec.artifact.ArtifactId",
      "x-ess-kind": "newtype",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "modelspec.artifact.ContentHash": {
      "title": "ContentHash",
      "description": "A blake3 digest under explicit serialization and version rules (DESIGN.md § 7), written as its 32 bytes in 64 lowercase hexadecimal digits (story:content-hash-schema-constrained).",
      "x-ess-name": "modelspec.artifact.ContentHash",
      "x-ess-kind": "newtype",
      "type": "string",
      "pattern": "^[0-9a-f]*$",
      "x-ess-invariants": [
        "value.count == 64"
      ],
      "x-ess-alphabet": "0123456789abcdef"
    },
    "modelspec.artifact.KernelCacheKey": {
      "title": "KernelCacheKey",
      "description": "The key a kernel configuration is cached under (DESIGN.md § 5.3).",
      "x-ess-name": "modelspec.artifact.KernelCacheKey",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "ir_hash": {
          "$ref": "#/$defs/modelspec.artifact.ContentHash",
          "description": "Hash of the kernel's IR (DESIGN.md § 5.3)."
        },
        "shapes": {
          "description": "The shapes the kernel was specialized for (DESIGN.md § 5.3).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/modelspec.checkpoint.Shape"
          }
        },
        "dtype": {
          "$ref": "#/$defs/modelspec.checkpoint.DType"
        },
        "fast_math": {
          "description": "Optimization setting (DESIGN.md § 3.3, § 5.3).",
          "type": "boolean"
        },
        "deterministic": {
          "description": "Optimization setting (DESIGN.md § 3.3, § 5.3).",
          "type": "boolean"
        },
        "vendor_id": {
          "description": "GPU vendor identifier, as DeviceProfile.vendor_id (DESIGN.md § 5.3).",
          "type": "integer"
        },
        "device_id": {
          "description": "GPU device identifier, as DeviceProfile.device_id (DESIGN.md § 5.3).",
          "type": "integer"
        },
        "driver_version": {
          "description": "Driver identifier, as DeviceProfile.driver_version (DESIGN.md § 5.3).",
          "type": "integer"
        },
        "capabilities": {
          "description": "The Vulkan extensions and SPIR-V capabilities the kernel uses, by name (DESIGN.md § 5.3 extension/capability set).",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "ir_hash",
        "shapes",
        "dtype",
        "fast_math",
        "deterministic",
        "vendor_id",
        "device_id",
        "driver_version",
        "capabilities"
      ],
      "additionalProperties": false,
      "x-ess-invariants": [
        "distinct capability in capabilities"
      ]
    },
    "modelspec.artifact.KernelModule.State": {
      "title": "State",
      "x-ess-name": "modelspec.artifact.KernelModule.State",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "Emitted"
      ]
    },
    "modelspec.artifact.KernelModuleId": {
      "title": "KernelModuleId",
      "x-ess-name": "modelspec.artifact.KernelModuleId",
      "x-ess-kind": "newtype",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "modelspec.checkpoint.DType": {
      "title": "DType",
      "description": "A tensor element type and its size in bytes; `f32` for every value, `i32` only for row ids an `embedding` reads, never a parameter or a checkpoint tensor (DESIGN.md § 2.2).",
      "x-ess-name": "modelspec.checkpoint.DType",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "F32",
        "I32"
      ],
      "x-ess-attributes": [
        {
          "kind": "integer",
          "name": "size_bytes",
          "type": "Integer",
          "values": {
            "F32": 4,
            "I32": 4
          }
        }
      ]
    },
    "modelspec.checkpoint.Shape": {
      "title": "Shape",
      "description": "A tensor shape; each dimension is a positive integer and rank 0 is a scalar (DESIGN.md § 2.2).",
      "x-ess-name": "modelspec.checkpoint.Shape",
      "x-ess-kind": "newtype",
      "type": "array",
      "items": {
        "type": "integer"
      },
      "x-ess-invariants": [
        "forall dim in value: (dim > 0)"
      ]
    }
  }
}
